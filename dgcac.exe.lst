.rdata:00437198                 db '*** DGCA(DGC Archiver) Version 1.10 for Windows95/98/Me/NT/2000/X'
.rdata:00437198                 db 'P',0Ah
.rdata:00437198                 db '*** Copyright (c) 2000-2005 SYN(Shin-ichi TSURUTA) All Rights Res'
.rdata:00437198                 db 'erved.',0Ah
.rdata:00437198                 db 0Ah
.rdata:00437198                 db ' usage: dgcac <command> [switches] <archive> <file or folder>',0Ah
.rdata:00437198                 db 0Ah
.rdata:00437198                 db ' <commands>',0Ah
.rdata:00437198                 db '   a create Archive from file or folder',0Ah
.rdata:00437198                 db '   e Extract files from archive',0Ah
.rdata:00437198                 db '   m coMpare archive',0Ah
.rdata:00437198                 db '   k checK archive',0Ah
.rdata:00437198                 db '   l List contents of archive',0Ah
.rdata:00437198                 db ' <switches>',0Ah
